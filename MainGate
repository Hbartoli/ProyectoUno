    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #f4f4f9;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        h1 {
            margin-bottom: 10px;
            color: #333;
        }
        p.subtitle {
            color: #666;
            margin-bottom: 40px;
            font-size: 16px;
        }
        /* Configuración de la Cuadrícula */
        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
            width: 100%;
            max-width: 1200px;
        }
        /* Estilo de los Enlaces */
        .card-link {
            text-decoration: none;
            color: white;
            display: block;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card-link:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
        }
        /* Estilo de las Cartas con Imagen de Fondo */
        .card {
            min-height: 200px;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        /* Capa oscura (Overlay) para proteger el texto */
        .card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.75));
            z-index: 1;
        }
        /* Contenedor del contenido para posicionarlo sobre el overlay */
        .card-content {
            position: relative;
            z-index: 2;
            padding: 25px 20px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex-grow: 1;
        }
        .card h3 {
            color: #4aff71; /* Verde brillante para resaltar sobre el fondo oscuro */
            margin-bottom: 10px;
            font-size: 20px;
        }
        .card p {
            color: #e0e0e0;
            font-size: 14px;
            margin-bottom: 15px;
        }
        .badge {
            align-self: center;
            display: inline-block;
            background-color: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 12px;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: bold;
            backdrop-filter: blur(4px); /* Efecto esmerilado moderno */
            border: 1px solid rgba(255,255,255,0.3);
        }
        /* Ocultar cartas extras por defecto */
        .extra {
            display: none;
        }
        /* Botón de Ver Más */
        .btn-container {
            margin-top: 40px;
        }
        button {
            padding: 12px 24px;
            font-size: 16px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.2s;
        }
        button:hover {
            background-color: #218838;
        }
    </style>
</head>
